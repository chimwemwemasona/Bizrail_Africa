# Prefer npm run local:configure to generate local credentials.
DATABASE_URL=postgresql://bizrail:local-development-only@127.0.0.1:5433/bizrail
NODE_ENV=development
OFFLINE_LEASE_MINUTES=1440
# Explicit local-only mode: Redis delivery/cache remains unavailable.
REDIS_ENABLED=false
REDIS_URL=
DOCUMENT_STORAGE_PATH=./storage/private
TZ=UTC
